<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Upcoming Tasks"
            android:textSize="14sp"
            android:textColor="#6C63FF"
            android:textStyle="bold" />
        
        <ImageView
            android:id="@+id/refresh_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Quick Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/action_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="+ Add"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/action_today"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="Today"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/action_inbox"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="Inbox"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Task 1 -->
    <LinearLayout
        android:id="@+id/task_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/task_time_1"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888" />
        
        <TextView
            android:id="@+id/task_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task 2 -->
    <LinearLayout
        android:id="@+id/task_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/task_time_2"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888" />
        
        <TextView
            android:id="@+id/task_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task 3 -->
    <LinearLayout
        android:id="@+id/task_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/task_time_3"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888" />
        
        <TextView
            android:id="@+id/task_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#333333"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No upcoming tasks"
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:paddingTop="8dp"
        android:visibility="visible" />

</LinearLayout>
